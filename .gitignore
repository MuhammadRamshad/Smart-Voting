# =============================================================================
# SMART VOTING SYSTEM - UNIFIED .GITIGNORE
# =============================================================================

# Node.js dependencies & logs
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Next.js build output
.next/
web/.next/
out/
web/out/

# Python virtual environment & cache
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
ai-service/venv/
ai-service/.venv/
venv/
.venv/
ai-service/saved_models/*.pkl

# Hardhat & Solidity compilation artifacts
contracts/cache/
contracts/artifacts/
contracts/typechain-types/

# Environment configurations (keep secrets out of git)
# .env
# .env.local
# .env.*.local
# *.env

# Operating System & Editors
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
